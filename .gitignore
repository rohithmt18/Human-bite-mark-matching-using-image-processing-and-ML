# =============================================================================
# BiteID — Forensic Bite-Mark Identification System
# .gitignore
# =============================================================================

# Python virtual environment (892 MB — never commit this)
bite_project - Copy/venv/
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Dataset images (445 MB — store with Git LFS or separately)
# To include datasets, remove this line and run: git lfs track "*.jpg"
bite_project - Copy/datasets/
datasets/

# Generated results (3.7 GB — regenerated by batch_process.py)
bite_project - Copy/results/
results/

# Uploaded query images (user data — not part of source)
bite_project - Copy/uploads/
uploads/

# Search history (runtime data)
bite_project - Copy/search_history.json

# History thumbnails (auto-generated at runtime by app.py — never commit)
bite_project - Copy/static/history_thumbs/
static/history_thumbs/

# Augmented images are auto-generated by augment_dataset.py
# (already excluded via datasets/ above)

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js / Vite build output
.next/
out/
dist/
build/

# Environment variables (NEVER commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
